#!/bin/sh
# mtk -- thin wrapper around the vendored mtkclient, so every invocation uses
# the right interpreter and runs from the right directory.
#
#   tools/mtk printgpt
#   tools/mtk r boot boot.img
#
# Two local patches are carried in vendor/mtkclient (see PATCHES.md): mfusepy
# raises OSError rather than ImportError when macFUSE is absent, which killed
# the CLI at import on any Mac without it.
here=$(cd "$(dirname "$0")" && pwd)
cd "$here/../vendor/mtkclient" || exit 1
exec .venv/bin/python mtk.py "$@"
