<?xml version="1.0" encoding="utf-8"?>
<!-- Palette read off img/FlipFlexSplashLogo_240x320.png and the proof-of-concept
     art reference: near-black ground, amber accent, white primary text. -->
<resources>
    <color name="ff_ground">#FF0F0F0F</color>
    <color name="ff_surface">#FF1A1A1A</color>
    <color name="ff_amber">#FFF5A623</color>
    <!-- There was a dimmed amber here for the selection bar of a list whose
         cursor had moved to the tabs or the header. It is gone on purpose: a
         second filled bar reads as a second cursor however dim it is. A parked
         list now draws no bar at all. See RowList.parked. -->
    <color name="ff_text">#FFFFFFFF</color>
    <color name="ff_text_dim">#FF8A8A8A</color>
    <color name="ff_rule">#FF2C2C2C</color>

    <!-- Badges and row accents.
         Amber is deliberately absent from both sets. It is the cursor, and a
         badge or a stripe wearing the cursor's colour is a second thing on
         screen claiming to be selected — the same confusion that removing the
         parked bar above was about.

         The hues are assigned by meaning, not by position, so the same fact is
         always the same colour: blue is what the file already is, green is what
         is about to reach the screen, violet is storage, rose is subtitles. -->
    <color name="ff_badge_source">#FF3E9BD1</color>
    <color name="ff_badge_target">#FF56B96A</color>
    <color name="ff_badge_local">#FFA97BD6</color>
    <color name="ff_badge_subs">#FFD86A8C</color>
    <color name="ff_badge_text">#FF0B0B0B</color>

    <!-- The two coloured keys, for the controls diagram only.
         These are not UI colours and carry no meaning in the app: they are
         what the plastic on the handset is. The tour calls one of them "the
         green key" in so many words, and a diagram that draws it the same grey
         as every other key makes the reader hunt for which one that is. -->
    <color name="ff_key_call">#FF4FB866</color>
    <color name="ff_key_end">#FFD1544F</color>
</resources>
