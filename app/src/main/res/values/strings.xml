<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">FlipFlex</string>

    <string name="link_go_to">On any browser, go to</string>
    <string name="link_url">plex.tv/link</string>
    <string name="link_waiting">Waiting for you to enter the code…</string>
    <string name="link_failed">Could not reach plex.tv.\nPress OK to retry.</string>
    <string name="link_expired">Code expired.\nPress OK for a new one.</string>

    <string name="soft_home">Home</string>
    <string name="soft_options">Options</string>
    <string name="soft_done">Done</string>

    <string name="home_continue">Continue Watching</string>
    <string name="home_recent">Recently Added</string>
    <string name="home_downloads">Downloads</string>
    <string name="home_settings">Settings</string>
    <string name="home_offline_note">The server is not reachable</string>

    <!-- Reorder mode. The help line has to name both jobs of the OK key,
         because OK meaning "pick up" and then "put down" is the one thing about
         this mode that cannot be guessed from looking at it.

         There is no home_reorder_note any more: reordering had a row of its own
         on the home screen as well as an entry in the Options menu, which spent
         a permanent row on something done once a year. -->
    <string name="home_reorder">Reorder libraries</string>
    <string name="home_reorder_help">OK picks a library up.\nUp and down move it.\nOK puts it back down.\n\nDone when you have finished.</string>

    <string name="downloads_empty">Nothing downloaded yet.\n\nOpen anything and choose\nDownload to keep a copy\non this phone.</string>

    <!-- Search. The prompt says which key got you here because the green call
         button is not a key anyone expects an app to own, and a screen that
         appears when you press it is only useful if you know why. -->
    <string name="search_title">Search</string>
    <string name="search_hint">Type a title</string>
    <string name="search_prompt">Type at least two letters.\n\nThe green call key opens\nthis from anywhere.</string>

    <!-- The T9 tip, on the search screen only.
         Whether the IME is already in predictive mode is not something an app
         can read — the mode lives inside com.iqqijni.dvt912key and is not
         exposed — so this is shown to everyone rather than only to the people
         who need it. It is a dim line at the bottom of a screen whose keyboard
         covers the rest, which is the cost of not being able to ask. -->
    <string name="search_t9_tip">Tip: press # until the screen shows EN KT9. Predictive text is much faster than tapping letters out.</string>

    <!-- The three library views, as Plex names them. Kept short: three of them
         share a 240dp row, so ~13 characters each is the whole budget. -->
    <string name="tab_recommended">Recommended</string>
    <string name="tab_library">Library</string>
    <string name="tab_categories">Categories</string>

    <!-- Settings' groups, which are tabs rather than captions in the list.
         Shorter than the captions they replace ("PLAYBACK", "DOWNLOADS") for no
         reason other than width: four of these share the strip. -->
    <string name="settings_tab_playback">Playback</string>
    <string name="settings_tab_downloads">Downloads</string>
    <string name="settings_tab_account">Account</string>
    <string name="settings_tab_help">Help</string>

    <!-- Mobile data. Both notes say what it will cost rather than that it will
         cost something, because "this may use mobile data" is a sentence people
         have learned to press through without reading. -->
    <string name="net_stream_title">Stream over mobile data?</string>
    <string name="net_stream_note">You are not on Wi-Fi. Streaming spends about 6 MB a minute at Standard quality — roughly 360 MB an hour.\n\nSettings · Playback · Wi-Fi only decides whether this is asked.</string>
    <string name="net_stream_go">Play anyway</string>
    <string name="net_stream_blocked">Wi-Fi only is on, so this will not stream on mobile data.\n\nSettings · Playback · Wi-Fi only</string>
    <string name="net_download_title">Download on mobile data?</string>
    <string name="net_download_note">You are not on Wi-Fi. A 45-minute episode is about 500 MB at the High preset.\n\nSettings · Downloads · Wi-Fi only decides whether this is asked.</string>
    <string name="net_download_go">Download anyway</string>
    <string name="net_download_waiting">Queued. It will download by itself the next time you are on Wi-Fi.</string>

    <!-- Direct play. The warning is the feature: this is an experiment that is
         expected to fail on part of any library, and someone who turns it on
         without knowing that reports it as a broken app. -->
    <string name="direct_play_title">Try direct play?</string>
    <string name="direct_play_go">Turn it on</string>
    <string name="direct_play_note">This chip decodes H.264, HEVC, VP9, MPEG-2, MPEG-4 and VC-1, all only up to 1600x960. A file above that size, or in anything else, will not play at all.\n\nFlipFlex normally has the server convert everything, so that every file in your library behaves the same way. This turns that off to see what the phone can manage on its own — expect some things to fail.</string>

    <string name="msg_loading">Loading…</string>
    <string name="msg_empty">Nothing here.</string>
    <string name="msg_no_server">No Plex server reachable.\nCheck Wi-Fi, then press OK.</string>
    <string name="pin_prompt">needs a PIN</string>
    <string name="pin_hint">Digits to enter · Back to delete · OK to confirm</string>
    <string name="pin_wrong">Wrong PIN. Try again.</string>

    <string name="msg_offline">Cannot reach Plex.\nPress OK to retry.</string>

    <!-- The tip jar, last row of Settings 4. Nothing else in the app mentions
         it. The address is in the row subtitle as well as here, because typing
         it on something with a keyboard beats filling in a payment form on a
         240x320 screen with T9. -->
    <string name="coffee_title">Buy me a coffee</string>
    <string name="coffee_no_browser">No browser on this phone.\n\n%1$s</string>

    <!-- Settings 4 → Check for updates. The prose says GitHub out loud because
         that is where the APK comes from and nothing else on this phone will
         ever offer it one; and it says the size, because the answer to "shall
         I?" on a metered link depends on it. -->
    <string name="update_title">Check for updates</string>
    <string name="update_subtitle">From the GitHub release page</string>
    <string name="update_checking">Checking…</string>
    <!-- Phrased as a fact about this phone rather than about the release page,
         because a development build is ahead of the newest release and "1.0.3
         is the newest release" would then be a lie about a version that is not
         published yet. -->
    <string name="update_current">You are on FlipFlex %1$s.\nNothing newer has been released.</string>
    <string name="update_failed">Could not reach GitHub.\nPress OK to try again.</string>
    <string name="update_found_title">FlipFlex %1$s is available</string>
    <string name="update_found_note">You are on %1$s. The download is %2$d MB, and the phone installs it itself — your Plex login and downloads are kept.</string>
    <!-- The same facts under a list of what is new, where the bullets have
         already earned the space and this only has to not repeat them. -->
    <string name="update_found_facts">You are on %1$s · %2$d MB · your login and downloads are kept.</string>
    <string name="update_found_go">Download and install</string>
    <string name="update_downloading">Downloading %1$d%%</string>
    <string name="update_source_title">Allow FlipFlex to install it?</string>
    <!-- "Help again" rather than "again", because Back from that screen does
         not come back here: Settings is usually destroyed behind it on a phone
         with this little memory, and returns on its first tab. -->
    <string name="update_source_note">Android needs this once, on a screen of its own: turn on “Allow from this source”, press Back, then open Help and choose Check for updates again.</string>
    <string name="update_source_go">Open that screen</string>
    <string name="update_source_missing">This phone has no screen for allowing app installs, so updates have to be installed over USB.</string>

    <!-- The controls tour. The footer names the key that advances it, because
         this is the one screen where the reader cannot be assumed to know. -->
    <string name="tour_title">Controls</string>
    <string name="tour_settings_note">The keypad, key by key</string>
    <string name="tour_skip">Skip</string>
    <string name="tour_skip_all">Skip the tour</string>
    <string name="tour_next">Next</string>
    <string name="tour_restart">Start again</string>
    <string name="tour_footer">%1$d of %2$d · OK for the next one</string>
    <string name="tour_footer_last">%1$d of %2$d · OK to finish</string>
</resources>
