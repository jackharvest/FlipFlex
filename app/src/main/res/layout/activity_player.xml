<?xml version="1.0" encoding="utf-8"?>
<!-- Now Playing. Landscape, immersive, and nothing permanent on screen but the
     picture.

     Rotated the panel is 320x240, so a 16:9 video is 320x180 instead of the
     240x135 it gets in portrait. Every piece of chrome that stays visible eats
     into that: the status bar, the shell header and the shell softkey bar
     together are 72 of 240 rows. So all three are hidden (see
     FlipActivity.setImmersive) and the controls below are drawn *over* the
     video, on a scrim, and fade themselves out after a few seconds.

     There is no layout-land variant. The screen can be turned three ways from
     the Options menu, but every one of them wants the same thing: video filling
     the frame with the controls banded across the bottom. A portrait variant
     would only restate this layout in a narrower box. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        app:use_controller="false"
        app:resize_mode="fit"
        app:surface_type="surface_view" />

    <!-- Everything below here is transient. It is shown on any key press and
         hidden again a few seconds later, so the steady state is bare video. -->
    <LinearLayout
        android:id="@+id/player_chrome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#B0000000"
        android:paddingHorizontal="6dp"
        android:paddingTop="3dp"
        android:paddingBottom="2dp">

        <TextView
            android:id="@+id/player_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/ff_text"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="1dp">

            <TextView
                android:id="@+id/player_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ff_amber"
                android:textSize="10sp"
                android:paddingEnd="4dp" />

            <TextView
                android:id="@+id/player_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ff_amber"
                android:textSize="10sp" />

            <ProgressBar
                android:id="@+id/player_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="5dp"
                android:max="1000"
                android:progressDrawable="@drawable/progress_amber" />

            <TextView
                android:id="@+id/player_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ff_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- The player's own softkey labels, because the shell's band is hidden.
             They sit here rather than in the shell so they fade with the rest of
             the controls instead of pinning 22dp of the picture permanently. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:text="@string/soft_home"
                android:textColor="@color/ff_text_dim"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="@string/soft_options"
                android:textColor="@color/ff_text_dim"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Kept so the browse screens can keep passing a subtitle, but never shown:
         in landscape there is no room for a second text line, and the show name
         is already in the title the user chose from. -->
    <TextView
        android:id="@+id/player_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</FrameLayout>
