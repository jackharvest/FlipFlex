<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- A download of a 40-minute episode takes minutes, and the user will
         close the lid partway through — which backgrounds the app, and a
         backgrounded process on API 30 has a few minutes at most before the
         platform may stop it. A foreground service is the only arrangement
         that survives that. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Settings → Help → Check for updates, which fetches the release APK from
         GitHub and hands it to the system installer. This has to be *declared*,
         not merely allowed: com.android.packageinstaller refuses any caller
         whose manifest lacks it, and says so only in the log —
           InstallStart: Requesting uid NNNN needs to declare permission
           android.permission.REQUEST_INSTALL_PACKAGES
         while the user sees nothing happen at all. Declaring it is also what
         un-greys the toggle on Settings → Install unknown apps; without it that
         screen renders for this app and cannot be switched on. See
         update/Updates.kt. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- The handset has no touchscreen worth speaking of and is driven entirely
         by the keypad. Declaring this stops the build system assuming a
         touch-first device and documents the input model for anyone reading. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FlipFlex"
        android:usesCleartextTraffic="true">

        <!-- cleartext is permitted because a Plex server on the LAN is reached
             over plain http whenever the phone's DNS cannot resolve the
             *.plex.direct hostname the certificate is issued for. See
             PlexServers.pick: without that fallback a perfectly good LAN server
             is simply "not found". API calls still prefer https when it works. -->

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LinkActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- singleTop so the Home softkey's CLEAR_TOP lands on the existing
             instance rather than building a second one on top of the first. -->
        <activity
            android:name=".ui.HomeActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- The controls tour. Shown once, ahead of whatever the first launch
             was going to show, and reachable from Settings for ever after. -->
        <activity
            android:name=".ui.TourActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.BrowseActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.SettingsActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- The page between choosing something and watching it: description,
             what the file is, subtitle and audio tracks, download. -->
        <activity
            android:name=".ui.DetailActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- keyboardHidden is deliberately NOT in configChanges here, unlike
             every other screen. This is the one activity with a text field, and
             the system IME appearing is a configuration change we want the
             platform to handle normally rather than swallow. -->
        <activity
            android:name=".ui.SearchActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".ui.DownloadsActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- Where an update's install session reports back to. Not exported:
             the only thing that ever sends to it is the platform, via the
             PendingIntent the session was committed with. -->
        <receiver
            android:name=".update.InstallReceiver"
            android:exported="false" />

        <!-- dataSync is only mandatory from API 34, and this app is API 30
             only. Declared anyway because it is the honest description of what
             the service does, and because an undeclared type is the kind of
             thing that becomes fatal in a later platform release. -->
        <service
            android:name=".dl.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- The only landscape screen in the app. A 16:9 video across the 320
             axis is 320x180 instead of 240x135, which is 1.8x the picture area
             on a panel where the picture is the whole experience.

             reverseLandscape, not landscape, and the difference is physical:
             plain landscape puts the edge carrying the power button and the
             headphone jack along the bottom, so a plugged-in handset cannot be
             stood on a table. Reverse puts the volume-rocker edge down, which
             sits flat. PlayerActivity overrides this at runtime from the user's
             saved choice — this value only decides the very first frame, and it
             matches the default so nothing rotates under the user.

             orientation|screenSize in configChanges is what lets that override
             re-lay the views out instead of recreating the activity, which
             would tear down ExoPlayer and the transcode with it. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:screenOrientation="reverseLandscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- Kept, and no longer the launcher. This is the activity that measured
             the keypad in Phase 1 and corrected the stock .kl files; it is worth
             having when a future build or a replaced keypad needs re-measuring.
             Launch it explicitly:
               adb shell am start -n com.github.jackharvest.flipflex/.probe.ProbeActivity -->
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
