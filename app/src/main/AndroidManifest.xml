<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- The handset has no touchscreen worth speaking of and is driven entirely
         by the keypad. Declaring this stops the build system assuming a
         touch-first device and documents the input model for anyone reading. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.FlipFlex"
        android:usesCleartextTraffic="true">

        <!-- cleartext is permitted because a Plex server on the LAN is reached
             over plain http whenever the phone's DNS cannot resolve the
             *.plex.direct hostname the certificate is issued for. See
             PlexServers.pick: without that fallback a perfectly good LAN server
             is simply "not found". API calls still prefer https when it works. -->

        <activity
            android:name=".ui.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.LinkActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- singleTop so the Home softkey's CLEAR_TOP lands on the existing
             instance rather than building a second one on top of the first. -->
        <activity
            android:name=".ui.HomeActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.BrowseActivity"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- The only landscape screen in the app. A 16:9 video across the 320
             axis is 320x180 instead of 240x135, which is 1.8x the picture area
             on a panel where the picture is the whole experience. -->
        <activity
            android:name=".ui.PlayerActivity"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <!-- Kept, and no longer the launcher. This is the activity that measured
             the keypad in Phase 1 and corrected the stock .kl files; it is worth
             having when a future build or a replaced keypad needs re-measuring.
             Launch it explicitly:
               adb shell am start -n io.github.jackharvest.flipflex/.probe.ProbeActivity -->
        <activity
            android:name=".probe.ProbeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="keyboardHidden|orientation|screenSize" />
    </application>
</manifest>
